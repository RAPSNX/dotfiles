{ pkgs, lib, ... }:
{
  services.kanshi =
    let
      hyprctl = lib.getExe' pkgs.hyprland "hyprctl";
      workspaceSetup = pkgs.writeShellScriptBin "workspaceSetup" ''
        primary="''${1:?missing primary monitor name}"
        secondary="''${2:?missing secondary monitor name}"

        # Switch away so workspaces to pin, are unfocused before rewriting the config.
        ${hyprctl} dispatch focusmonitor $primary && ${hyprctl} dispatch workspace 9
        ${hyprctl} dispatch focusmonitor $secondary && ${hyprctl} dispatch workspace 10
        ${hyprctl} dispatch focusmonitor $primary

        cat > "$HOME/.config/hypr/workspaces.conf" <<EOF
        # Generated by RAPSN workspaceSetup on "$(date +"%d-%m-%Y at %H:%M:%S")".

        workspace = 1, monitor:$primary, default:true
        workspace = 2, monitor:$primary
        workspace = 3, monitor:$secondary, default:true
        workspace = 4, monitor:$secondary
        EOF

        # Reload and focus default workspaces
        ${hyprctl} reload &&
        ${hyprctl} dispatch workspace 4 &&
        ${hyprctl} dispatch workspace 1
      '';
      mkProfile =
        {
          name,
          primary,
          secondary ? { },
          additional ? [ ],
        }:
        let
          hasSecondary = secondary != { };
        in
        {
          profile = {
            inherit name;

            outputs = [ primary ] ++ lib.optional hasSecondary secondary ++ additional;
          }
          // lib.optionalAttrs hasSecondary {
            exec = "${lib.getExe workspaceSetup} ${primary.criteria} ${secondary.criteria}";
          };
        };
    in
    {
      enable = true;
      systemdTarget = "hyprland-session.target";

      settings = [
        (mkProfile {
          name = "firefly-home";
          primary = {
            criteria = "DP-1";
            scale = 1.5;
            position = "2560,0";
            mode = "3840x2160@239.99Hz";
          };
          secondary = {
            criteria = "DP-2";
            scale = 1.0;
            position = "0,0";
            mode = "2560x1440@239.96Hz";
          };
        })

        (mkProfile {
          name = "firefly-office";
          primary = {
            criteria = "DP-2";
            mode = "3440x1440@99.98Hz";
          };
        })
        # TODO: Firefly meeting room

        (mkProfile {
          name = "zion-home";
          primary = {
            criteria = "DP-2";
            scale = 1.5;
            position = "2560,0";
            mode = "3840x2160@239.99Hz";
          };
          secondary = {
            criteria = "DP-1";
            scale = 1.0;
            position = "0,0";
            mode = "2560x1440@240.00Hz";
          };
        })
      ];
    };
}
