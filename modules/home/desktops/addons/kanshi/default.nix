{
  pkgs,
  lib,
  self,
  ...
}:
{
  services.kanshi =
    let
      hyprctl = lib.getExe' pkgs.hyprland "hyprctl";
      workspaceSetup =
        let
          jq = lib.getExe pkgs.jq;
          wallpaperPath = "${self.outPath}/extra/wallpapers";
          wallpapers = lib.escapeShellArgs (builtins.attrNames (builtins.readDir wallpaperPath));
        in
        pkgs.writeShellScriptBin "workspaceSetup" ''
          set -euo pipefail

          primary_desc="''${1:?missing primary monitor description}"
          secondary_desc="''${2:-$primary_desc}"
          monitors="$(${hyprctl} monitors -j)"

          output_name() {
            local label="$1"
            local matcher="$2"
            local output

            output="$(${jq} -r --arg matcher "$matcher" '
              [.[] | select(.name == $matcher or (.description | test($matcher))) | .name][0] // empty' <<< "$monitors")"

            if [[ -z "$output" ]]; then
              echo "workspaceSetup: $label output not found for $matcher" >&2
              exit 1
            fi

            printf '%s\n' "$output"
          }

          primary="$(output_name primary "$primary_desc")"
          secondary="$(output_name secondary "$secondary_desc")"

          cat > "$HOME/.config/hypr/workspaces.conf" <<EOF_WORKSPACES
          # Generated by kanshi on $(date +"%d-%m-%Y at %H:%M:%S"). Do not edit manually.

          workspace = 1, monitor:$primary, default:true
          workspace = 2, monitor:$primary
          workspace = 3, monitor:$secondary
          workspace = 4, monitor:$secondary
          EOF_WORKSPACES

          ${hyprctl} reload
          ${hyprctl} dispatch moveworkspacetomonitor "1 $primary"
          ${hyprctl} dispatch moveworkspacetomonitor "2 $primary"
          ${hyprctl} dispatch moveworkspacetomonitor "3 $secondary"
          ${hyprctl} dispatch moveworkspacetomonitor "4 $secondary"

          ${hyprctl} hyprpaper wallpaper "$primary, ${wallpaperPath}/$(shuf -n 1 -e ${wallpapers})"

          if [[ "$secondary" != "$primary" ]]; then
            ${hyprctl} hyprpaper wallpaper "$secondary, ${wallpaperPath}/$(shuf -n 1 -e ${wallpapers})"
          fi

          ${hyprctl} dispatch focusmonitor "$primary"
          ${hyprctl} dispatch workspace 1
          systemctl --user restart waybar.service
        '';
      mkProfile =
        {
          name,
          outputs,
          primary,
          secondary ? null,
        }:
        {
          profile = {
            inherit name outputs;
            exec = "${lib.getExe workspaceSetup} ${
              lib.escapeShellArgs ([ primary ] ++ lib.optional (secondary != null) secondary)
            }";
          };
        };
    in
    {
      enable = true;
      systemdTarget = "hyprland-session.target";

      settings = [
        {
          output = {
            criteria = "eDP-1";
            position = "0,0";
            mode = "1920x1200@60.00Hz";
          };
        }

        {
          # Default profile, without exec
          profile = {
            name = "undocked";
            outputs = [
              {
                criteria = "eDP-1";
              }
            ];
          };
        }

        (mkProfile {
          name = "office";
          primary = "HP Inc. HP 534pm *";
          outputs = [
            {
              criteria = "HP Inc. HP 534pm *";
              mode = "3440x1440@99.98Hz";
              position = "0,0";
              scale = 1.0;
            }
            {
              criteria = "AU Optronics *";
              mode = "1920x1200@60.00Hz";
              position = "760,1440";
            }
          ];
        })

        # TODO: Add meeting room here

        (mkProfile {
          name = "home-firefly";
          primary = "Dell Inc. AW2725Q G2QC174";
          secondary = "Samsung Electric Company LC27G7xT H4ZNC00167";
          outputs = [
            {
              criteria = "Dell Inc. AW2725Q G2QC174";
              scale = 1.5;
              position = "2560,0";
              mode = "3840x2160@239.99Hz";
            }
            {
              criteria = "Samsung Electric Company LC27G7xT H4ZNC00167";
              scale = 1.0;
              position = "0,0";
              mode = "2560x1440@239.96Hz";
            }
            {
              criteria = "*";
            }
          ];
        })

        (mkProfile {
          name = "home";
          primary = "Dell Inc. AW2725Q G2QC174";
          secondary = "Samsung Electric Company LC27G7xT H4ZNC00167";
          outputs = [
            {
              criteria = "Dell Inc. AW2725Q G2QC174";
              scale = 1.5;
              position = "2560,0";
              mode = "3840x2160@239.99Hz";
            }
            {
              criteria = "Samsung Electric Company LC27G7xT H4ZNC00167";
              scale = 1.0;
              position = "0,0";
              mode = "2560x1440@239.96Hz";
            }
          ];
        })
      ];
    };
}
